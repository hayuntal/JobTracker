# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Telegram (the delivery channel) ---------------------------------------
# One-time setup, about a minute:
#   1. In Telegram, message @BotFather and send:  /newbot
#   2. Pick a name, then a username ending in 'bot'.
#   3. BotFather replies with a token — paste it below.
#   4. Send your new bot any message (e.g. /start) so it's allowed to reply.
#   5. Run:  python -m jobtracker setup-telegram
#      That verifies the token, finds your chat id and writes it here for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning --------------------------------------------------------
# Max jobs per message batch. Anything over the cap is NOT dropped — it is held
# back and delivered on the next run, so a backlog drains rather than vanishing.
# Set to 0 for no cap.
DIGEST_MAX_JOBS=12

# --- Optional: WhatsApp fallback via CallMeBot ------------------------------
# Only used if the Telegram values above are blank. Setup:
#   1. Save +34 644 51 95 23 to your contacts as "CallMeBot".
#   2. WhatsApp it:  I allow callmebot to send me messages
#   3. It replies with an API key.
# Phone in full international format, digits only, no + and no spaces.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Optional: Facebook groups source (off by default, best-effort) --------
# Requires a logged-in session cookie; expires often. Enable with
# `--enable facebook`. Leave blank to keep this source off.
FACEBOOK_COOKIE=
