# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- WhatsApp via CallMeBot -------------------------------------------------
# Setup (one time, ~2 minutes):
#   1. Save +34 644 51 95 23 to your phone contacts as "CallMeBot".
#   2. Send it this WhatsApp message:   I allow callmebot to send me messages
#   3. You get an API key back in the reply. Paste it below.
# Phone must be in full international format, digits only, no + and no spaces.
CALLMEBOT_PHONE=972500000000
CALLMEBOT_APIKEY=

# --- Optional: Facebook groups source --------------------------------------
# Requires a logged-in session cookie. Leave blank to keep this source off.
# See README "Facebook groups" for why this one is best-effort.
FACEBOOK_COOKIE=

# --- Optional tuning --------------------------------------------------------
# Max jobs listed in a single WhatsApp digest before it splits into more
# messages. CallMeBot rejects very long URLs, so keep this modest.
DIGEST_MAX_JOBS=12
